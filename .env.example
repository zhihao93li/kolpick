# 本地运行时复制成 .env 再改。部署到 Zeabur 时在服务的「环境变量」里填同样的名字，不用这个文件。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kolpick
# 登录密码：先运行 npm run hash-password -- '你的密码'，把输出整行填到这里
ADMIN_PASSWORD_HASH=
# 随便一串足够长的随机字符，用来签登录 cookie；改了所有人要重新登录
SESSION_SECRET=
# Apify Console > Settings > API & Integrations
APIFY_TOKEN=
# 网站地址，飞书通知里的链接会用到，例如 https://kol.zeabur.app
PUBLIC_URL=
